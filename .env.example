# Discord Bot
DISCORD_TOKEN=your_bot_token_here

# Database
DATABASE_URL=sqlite:///tippy.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/tippy

# Blockchain APIs
LITECOIN_API_KEY=your_ltc_api_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_API_KEY=your_solana_api_key

# Bot Settings
BOT_PREFIX=$
LOG_CHANNEL_ID=
WITHDRAW_CHANNEL_ID=

# Minimum Confirmations
LTC_MIN_CONFIRMATIONS=3
SOL_MIN_CONFIRMATIONS=15

# Withdrawal Fees (in percentage)
LTC_WITHDRAW_FEE=0.0002
SOL_WITHDRAW_FEE=0.00025

# Cooldowns (in seconds)
TIP_COOLDOWN=5
WITHDRAW_COOLDOWN=300
DEPOSIT_COOLDOWN=60
RAIN_COOLDOWN=600
AIRDROP_COOLDOWN=1200

# Feature Settings
MAX_RAIN_PARTICIPANTS=100
MIN_RAIN_AMOUNT=0.001
MAX_RAIN_AMOUNT=100

# Admin Settings
ADMIN_IDS=
MOD_IDS=
